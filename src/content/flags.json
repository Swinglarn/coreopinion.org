{
  "title": "Flags",
  "header": "Flags",
  "subtitle": "Fly your colors. Quality national flags shipped from Amazon - one for every country in our political tests.",
  "desc": "Shop durable, vibrant national flags for every country. As an Amazon Associate, CoreOpinion earns from qualifying purchases.",
  "content": "<div class=\"books-affiliate-disclosure\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><line x1=\"12\" y1=\"16\" x2=\"12\" y2=\"12\"/><line x1=\"12\" y1=\"8\" x2=\"12.01\" y2=\"8\"/></svg> As an Amazon Associate, CoreOpinion earns from qualifying purchases. Links on this page are affiliate links.</div><div class=\"books-region-bar\"><label for=\"region-select\">Your Amazon store:</label><select id=\"region-select\" onchange=\"switchRegion(this.value)\"><option value=\"us\">🇺🇸 United States</option><option value=\"uk\">🇬🇧 United Kingdom</option><option value=\"ca\">🇨🇦 Canada</option><option value=\"au\">🇦🇺 Australia</option><option value=\"nz\">🇳🇿 New Zealand</option><option value=\"se\">🇸🇪 Sweden</option><option value=\"dk\">🇩🇰 Denmark</option><option value=\"no\">🇳🇴 Norway</option><option value=\"fi\">🇫🇮 Finland</option><option value=\"de\">🇩🇪 Germany</option><option value=\"at\">🇦🇹 Austria</option><option value=\"fr\">🇫🇷 France</option><option value=\"es\">🇪🇸 Spain</option><option value=\"it\">🇮🇹 Italy</option><option value=\"ie\">🇮🇪 Ireland</option><option value=\"nl\">🇳🇱 Netherlands</option></select></div><div id=\"flags-grid\" class=\"flags-grid\"></div><script src=\"/flags-data.js\"></script><script>(function(){var currentRegion='us';function detectRegion(){var saved=localStorage.getItem('co_flag_region');if(saved&&FLAG_REGIONS[saved])return saved;var lang=navigator.language||navigator.userLanguage||'en';lang=lang.toLowerCase();var map={'sv':'se','sv-se':'se','da':'dk','da-dk':'dk','nb':'no','nn':'no','nb-no':'no','nn-no':'no','fi':'fi','fi-fi':'fi','de':'de','de-de':'de','de-at':'at','de-ch':'de','fr':'fr','fr-fr':'fr','fr-ca':'ca','fr-be':'fr','es':'es','es-es':'es','it':'it','it-it':'it','nl':'nl','nl-nl':'nl','nl-be':'nl','en-gb':'uk','en-au':'au','en-nz':'nz','en-ca':'ca','en-ie':'ie','en-us':'us','en':'us'};for(var key in map){if(lang===key||lang.startsWith(key+'-'))return map[key];}return 'us';}function getLink(flag,region){if(flag.links[region]&&flag.links[region]!=='#')return flag.links[region];if(flag.links.us&&flag.links.us!=='#')return flag.links.us;var domain=FLAG_REGIONS[region]?FLAG_REGIONS[region].domain:'amazon.com';return 'https://www.'+domain+'/s?k='+encodeURIComponent(flag.name);}function getImg(code){return '/images/flags/'+code+'.webp';}function renderFlags(region){var grid=document.getElementById('flags-grid');grid.innerHTML='';FLAGS_DATA.forEach(function(flag,i){var link=getLink(flag,region);var card=document.createElement('a');card.href=link;card.target='_blank';card.rel='noopener noreferrer sponsored';card.className='book-card flag-card';card.style.animationDelay=(i*0.06)+'s';card.innerHTML='<div class=\"flag-cover-wrap\"><img src=\"'+getImg(flag.code)+'\" alt=\"'+flag.name+'\" loading=\"lazy\" /></div><div class=\"book-info\"><h3 class=\"book-title\">'+flag.name+'</h3><p class=\"book-desc\">'+flag.description+'</p><span class=\"book-cta\">View on Amazon <svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M7 17L17 7\"/><path d=\"M7 7h10v10\"/></svg></span></div>';grid.appendChild(card);});}window.switchRegion=function(r){currentRegion=r;localStorage.setItem('co_flag_region',r);renderFlags(r);};var detected=detectRegion();currentRegion=detected;var sel=document.getElementById('region-select');if(sel)sel.value=detected;renderFlags(detected);})();</script>"
}
